  "stateOwnership": {
    "Mouse": "one gesture owner holds the original lastClick and drag references; Mouse keeps pointer/hover, input bookkeeping and down routing; overlay/wheel/hot routing remains App-backed",
    "Vim": "App retains its single VimState and buffers; grammar/operators/motions/edits/replay use that same live owner; no state copies or new timers",
    "Keys": "same binding objects and ordered window/tab generation loops; facade exports retain identity"
  },
  "guards": {
    "inputOwners": "keys/, vim/, mouse/ reject their own facade, including types; all reject runtime App, and key data also rejects App types",
    "interaction": "Mouse and Vim clients intentionally retain App types; no gateway execution is introduced"
  },
