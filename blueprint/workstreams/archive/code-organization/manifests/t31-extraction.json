  "tests": {
    "removed": [],
    "added": [
      "test: Vim state instances keep separate registers and consuming a count clears it",
      "test: a consumed click resets its original history without becoming a double click",
      "test: a counted operator is cancelled through grammar without dispatching a command",
      "test: a save-as overlay without drawn choices closes through the existing outside-click policy",
      "test: an unrecordable visual change clears an older replay instead of repeating it",
      "test: binding owners retain generated window and numbered tab chords beside extended movement",
      "test: context bindings retain source operators and independent pane overrides",
      "test: decoding separates printable text from modified terminal names and help spelling",
      "test: failed replay restores replay state in finally and replaces a recorded count",
      "test: group help splits its first colon and aliases retain save and quit commands",
      "test: input mechanisms reject their own facade and runtime App while allowing interaction types",
      "test: line ranges retain final-newline admission and clamp to the final real line",
      "test: operator effects retain invalid-encoding refusal before changing a buffer or register",
      "test: pointer click history uses the live clock and position with a strict interval",
      "test: rectangle routing includes top-left and excludes bottom-right edges",
      "test: text objects preserve nested bracket contents and counted words"
    ]
  },
