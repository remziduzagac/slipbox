    "added": [
      "describe: clipboard serialization without App",
      "describe: document tool row navigation without App",
      "describe: notification timing without App",
      "test: document tool movement unpins before selection and resumes the existing filter",
      "test: down and up clamp to their existing bounds",
      "test: eight pending copies admit no ninth; completion frees the same queue",
      "test: failure reports once and does not poison later copies",
      "test: fallback announcements distinguish an intentional file, unavailable clipboard and silent copies",
      "test: feature actions leave selection and every other pane property untouched",
      "test: five pane owners keep close and leave distinct on wide, narrow and zen screens",
      "test: leaving either side preserves wide preferences and hides only its narrow or zen overlay",
      "test: paste keeps the register's identity and linewise flag for absent, empty or equal clipboard text",
      "test: paste snapshots the register before its read, sharing the cancellation signal",
      "test: quit aborts the running helper, skips queued helpers and ignores its late reply",
      "test: rescheduling and dismissal clear the previous timer and retain the ten-millisecond floor",
      "test: terminal delivery is immediate; helpers and paste wait in copy order and read the live vault",
      "test: the next drawn deadline expires info at four seconds and errors at eight, redrawing each",
      "test: top and bottom jump directly, preserving the empty-list minus-one result",
      "test: undrawn messages have no running lifetime, even after a long busy interval"
    ]
