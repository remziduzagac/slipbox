# Production environment template. Placeholders only: the real values are in the vault.
# Copy to .env on the host and fill in.

export NODE_ENV=production
export KESTREL_REGION=eu-west-1
DATABASE_URL=postgres://kestrel:CHANGEME@db.kestrel.internal:5432/kestrel?sslmode=require
REDIS_URL=redis://cache.kestrel.internal:6379/0
SYNC_ENDPOINT="https://sync.kestrel.dev/v2"   # the worker, behind the load balancer
SYNC_RETRY_BUDGET=5
SENTRY_DSN=
SLACK_WEBHOOK_URL=
TILE_ATTRIBUTION='(c) OpenStreetMap contributors'
FEATURE_ROUTE_SHARING=true
S3_BUCKET	=	kestrel-routes-prod   
SMTP_FROM="Kestrel <no-reply@kestrel.dev>"  
LOG_LEVEL=info	
