# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_size = 4
max_line_length = 88

[*.{go,mk}]
indent_style = tab

[Makefile]
indent_style = tab

[*.rs]
indent_size = 4
max_line_length = 100

[*.md]
# trailing double spaces are hard breaks in Markdown
trim_trailing_whitespace = false
max_line_length = 120

[{package.json,package-lock.json}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.sh]
indent_size = 2
switch_case_indent = true

[docs/qa/render-torture.md]
max_line_length = off
