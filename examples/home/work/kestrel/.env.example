# Copy to .env and fill in. Never commit the real one (it is in .gitignore).
# Anything marked REQUIRED stops the API from starting when it is missing.

# --- database -------------------------------------------------------------
export DATABASE_URL="postgres://kestrel:change-me@localhost:5432/kestrel"   # REQUIRED
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379/0

# --- signing --------------------------------------------------------------
# Share links are HMAC-signed (docs/adr/0003-sharing-links.md). Any 32+ char string locally.
SHARE_LINK_SECRET='<generate with: openssl rand -hex 32>'     # REQUIRED
SHARE_LINK_TTL_HOURS=72

# --- tiles ----------------------------------------------------------------
TILE_SERVER_URL="http://localhost:8081/{z}/{x}/{y}.pbf"
export TILES_API_KEY=""        # leave empty to use the local tile server

# --- mail (mailhog catches everything) -------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Kestrel <no-reply@kestrel.dev>"

# --- misc -----------------------------------------------------------------
LOG_LEVEL=debug
FEATURE_FLAGS_FILE=config/feature-flags.json
SENTRY_DSN=
