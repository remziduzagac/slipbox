---
extends: default

rules:
  line-length:
    max: 80
    level: warning
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
  document-start:
    present: true
  truthy:
    allowed-values: ["true", "false", "on"]
    check-keys: false
  indentation:
    spaces: 2
    indent-sequences: true
  comments:
    min-spaces-from-content: 2
  comments-indentation: enable
  trailing-spaces: enable
  empty-lines:
    max: 1

ignore: |
  node_modules/
  build/
  api/openapi.yaml
