{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kestrel.example/schemas/common.json",
  "title": "Shared definitions",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]{8}$",
      "description": "An opaque eight-character id"
    },
    "point": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "ele": { "type": "number" }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "surface/type": {
      "type": "string",
      "description": "Surface class as the importer writes it, referenced as #/definitions/surface~1type"
    }
  }
}
