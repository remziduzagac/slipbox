{
  "name": "kestrel-web",
  "version": "2.3.0",
  "private": true,
  "description": "The Kestrel web app: a cycling route planner that works offline.",
  "type": "module",
  "homepage": "https://kestrel.dev",
  "bugs": "https://github.com/kestrel-labs/kestrel/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kestrel-labs/kestrel.git"
  },
  "mirrors": ["git://git.kestrel.dev/kestrel.git", "https://gitlab.com/kestrel-labs/kestrel-mirror"],
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build --outDir build/web",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && biome check src/",
    "format": "biome format --write src/",
    "docs": "mkdocs build --strict",
    "prepare": "husky"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.27.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/react": "^18.3.11",
    "eslint": "^9.12.0",
    "husky": "^9.1.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  },
  "workspaces": ["src/web"],
  "files": ["build/web", "public", "LICENSE"],
  "engines": { "node": ">=20" },
  "browserslist": ["Safari >= 16", "Chrome >= 110", "Firefox ESR"],
  "contributors": [
    { "name": "Sam Rivera", "email": "sam@kestrel.dev", "role": "product lead" },
    { "name": "Aiko Tanaka", "email": "aiko@kestrel.dev", "role": "backend" },
    { "name": "Priya Nair", "email": "priya@kestrel.dev", "role": "engineering manager" },
    { "name": "Tomás Ruiz", "email": "tomas@kestrel.dev", "role": "design" }
  ]
}
