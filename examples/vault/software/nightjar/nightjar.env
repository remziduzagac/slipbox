# nightjar's environment on ridge-arch. Secrets are NOT here: they come from the vault agent.
# Read by deploy.yaml's containers; see ../pipeline-cookbook.md for what each one does.

NIGHTJAR_PORT=8080
NIGHTJAR_ARCHIVE_ROOT=/srv/stacks
export NIGHTJAR_LOG_LEVEL=info
NIGHTJAR_PUBLIC_URL="https://nightjar.halden-ridge.invalid/v2"
NIGHTJAR_THUMB_SIZES='256,1024'
NIGHTJAR_MAX_UPLOAD_MB=512   # a full-frame Aster stack is ~180 MB
NIGHTJAR_READONLY=false
