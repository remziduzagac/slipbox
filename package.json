{
  "name": "slipbox",
  "version": "0.5.1",
  "description": "The terminal companion for coding agents. Read, review and edit what your agent writes, with Markdown and code rendered cleanly, an editor that's necessary and sufficient, and agent integration built in.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "slipbox": "src/main.ts"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "test": "bun test --timeout 30000",
    "test:docs": "bun test --timeout 30000 ./tests/docs.test.ts ./tests/site.test.ts",
    "test:terminal": "bun tests/terminal/run.ts",
    "test:changed": "bun scripts/ci-scope.ts test",
    "test:terminal:changed": "bun scripts/ci-scope.ts terminal",
    "test:herdr": "bun tests/terminal/herdr/run.ts",
    "shots": "bun tests/terminal/shots.ts",
    "typecheck": "tsc --noEmit -p .",
    "check:boundary": "bun scripts/check-boundary.ts",
    "check:deps": "bun scripts/check-deps.ts",
    "ci:scope": "bun scripts/ci-scope.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "check:size": "bun scripts/check-size.ts",
    "check:actions": "zizmor .github && actionlint",
    "audit": "bun scripts/audit.ts",
    "site": "bun install --cwd site --frozen-lockfile && bun run --cwd site build",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run check:boundary && bun run check:size && bun run check:deps && bun run lint && bun run check:actions && bun run check:docs && bun run test:changed",
    "build": "bun build --compile --root=src --no-compile-autoload-bunfig --no-compile-autoload-dotenv --no-compile-autoload-tsconfig --no-compile-autoload-package-json src/main.ts src/core/backlinks-worker.ts src/core/diagram-worker.ts src/core/export-worker.ts src/core/list-worker.ts src/core/paint-worker.ts src/core/parse-worker.ts src/core/regex-worker.ts src/core/spell-worker.ts src/core/syntax-worker.ts src/core/walk-worker.ts src/tui/opentui.ts --outfile dist/slipbox"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@opentui/core": "0.5.14",
    "@resvg/resvg-wasm": "2.6.2",
    "@tree-sitter-grammars/tree-sitter-lua": "0.4.1",
    "@tree-sitter-grammars/tree-sitter-svelte": "1.0.2",
    "beautiful-mermaid": "1.1.3",
    "dictionary-en": "4.0.0",
    "dictionary-tr": "2.0.0",
    "docx": "9.9.0",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "get-east-asian-width": "1.7.0",
    "hast-util-to-html": "9.0.5",
    "highlight.js": "11.12.0",
    "hunspell-asm": "4.0.2",
    "ignore": "7.0.12",
    "linebreak": "1.1.0",
    "mathjax-full": "3.2.2",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.2.0",
    "mdast-util-to-string": "4.0.0",
    "pdfkit": "0.20.2",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "smol-toml": "1.9.0",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-css": "0.25.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-html": "0.23.2",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "unicodeit": "0.7.5",
    "unified": "11.0.5",
    "vscode-languageserver-protocol": "3.18.4",
    "vscode-languageserver-textdocument": "1.0.15",
    "web-tree-sitter": "0.25.10",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/mdast": "4.0.4",
    "@types/pdfkit": "0.17.6",
    "@xterm/headless": "6.0.0",
    "markdownlint-cli2": "0.23.3",
    "typescript": "7.0.2",
    "vscode-languageserver": "10.1.2"
  },
  "overrides": {
    "smol-toml": "1.9.0"
  }
}
