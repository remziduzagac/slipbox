exports[`snapshots of the layout IR as text software/halley/logging.ini @ 80 1`] = `
" halley's logging, read at start-up (Python's logging.config.fileConfig format).
 Change the level here, not in the code: see ../pipeline-cookbook.md.

▌ loggers

 keys  root, reduce, archive

▌ handlers

 keys  console, nightly

▌ formatters

 keys  plain

▌ logger_root

 level     WARNING
 handlers  console

▌ logger_reduce

 level      INFO  # DEBUG floods the disk on a full night
 handlers   console, nightly
 qualname   halley.reduce
 propagate  0

▌ logger_archive

 level     INFO
 handlers  nightly
 qualname  halley.archive

▌ handler_console

 class      StreamHandler
 formatter  plain
 args       (sys.stderr,)

▌ handler_nightly

 class      handlers.TimedRotatingFileHandler
 formatter  plain
 args       ('/var/log/halley/halley.log', 'midnight', 1, 120)  # one file a
            night, kept for a season

▌ formatter_plain

 format  %(asctime)s %(levelname)-7s %(name)s: %(message)s"
`;

